# Application
PORT=3000
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=eco-drone-db

# Database URL for Prisma
# For Docker: use service name 'postgres' as host
# For local development: use 'localhost'
DATABASE_URL="postgresql://postgres:your_secure_password_here@postgres:5432/eco-drone-db?schema=public"

# JWT Configuration
# Generate secure random keys for production
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_KEY="your_jwt_secret_key_minimum_32_characters"
REFRESH_JWT_KEY="your_refresh_jwt_secret_key_minimum_32_characters"

# Note: For local development (non-Docker), change DATABASE_URL host from 'postgres' to 'localhost'
# DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/eco-drone-db?schema=public"
